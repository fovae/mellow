// Cloudflare Workers: the app and its account API on one origin.
// Setup and deploy: see docs/SERVER.md.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mellow",
    "main": "server/worker.js",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "d1_databases": [
        // database_id comes from: npx wrangler d1 create mellow
        { "binding": "DB", "database_name": "mellow", "database_id": "00000000-0000-0000-0000-000000000000" }
    ],
    // Per key and per Cloudflare location; period is 10 or 60 seconds.
    "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SAVE_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
    ],
    "observability": { "enabled": true }
}
