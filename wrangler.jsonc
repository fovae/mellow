// Cloudflare Workers: the app and its account API on one origin.
// Setup and deploy: see docs/SERVER.md.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mellow",
    "main": "server/worker.js",
    "compatibility_date": "2026-11-01",
    // Address: https://mellow.<account>.workers.dev (no own domain yet).
    "workers_dev": true,
    // No public URL for every uploaded version: they would share the real database.
    "preview_urls": false,
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        // "/" goes through the Worker: with html_handling "none" there are no redirects,
        // which the service worker cannot serve offline (Safari refuses redirected responses).
        "run_worker_first": ["/api/*", "/"],
        "html_handling": "none"
    },
    "d1_databases": [
        // database_id comes from: npx wrangler d1 create mellow
        { "binding": "DB", "database_name": "mellow", "database_id": "ae2d952e-50be-406e-9d54-22cef7d416e8" }
    ],
    // Per key and per Cloudflare location; period is 10 or 60 seconds.
    "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SAVE_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
    ],
    "observability": { "enabled": true }
}
